# ==========================================
# Root Environment Configuration Reference
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration
MONGO_URI=mongodb://localhost:27017/git_security_dashboard

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_jwt_secret_in_production
JWT_EXPIRES_IN=7d

# Scanning Configuration
SCAN_TEMP_DIR=./temp_scans
GITLEAKS_PATH=gitleaks
TRIVY_PATH=trivy

# Frontend Configuration
VITE_API_BASE_URL=/api
